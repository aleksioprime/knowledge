{
  "info": {
    "_postman_id": "883d7bd3-6925-47e6-ac0c-f7fc69b0f5f4",
    "name": "Задачник",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Новый email при каждом запуске, чтобы регистрация не упала с 409",
              "pm.collectionVariables.set('email', `user-${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Пользователь создан', () => {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Вход",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "{{email}}"
            },
            {
              "key": "password",
              "value": "{{password}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Токен выдан', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().token_type).to.eql('bearer');",
              "});",
              "pm.collectionVariables.set('token', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Создать задачу",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Сдать отчёт\",\n  \"priority\": 3,\n  \"due_date\": \"2026-11-01\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Задача создана', () => {",
              "    pm.response.to.have.status(201);",
              "    const task = pm.response.json();",
              "    pm.expect(task.title).to.eql('Сдать отчёт');",
              "    pm.expect(task.done).to.be.false;",
              "    pm.collectionVariables.set('taskId', task.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Неверные данные",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"priority\": 10\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ошибки в названии и приоритете', () => {",
              "    pm.response.to.have.status(422);",
              "    const fields = pm.response.json().detail.map(error => error.loc.at(-1));",
              "    pm.expect(fields).to.have.members(['title', 'priority']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Отметить выполненной",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"done\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Изменилось только поле done', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().done).to.be.true;",
              "    pm.expect(pm.response.json().priority).to.eql(3);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Статистика",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "stats"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статистика учла задачу', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.eql({total: 1, done: 1});",
              "});",
              "pm.test('Ответ быстрее 500 мс', () => pm.expect(pm.response.responseTime).to.be.below(500));"
            ]
          }
        }
      ]
    },
    {
      "name": "Без токена",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Нужна авторизация', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Удалить задачу",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Удалена', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Удалённой задачи нет",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 и понятное сообщение', () => {",
              "    pm.response.to.have.status(404);",
              "    pm.expect(pm.response.json().detail).to.eql('Задача не найдена');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "secret123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ]
}